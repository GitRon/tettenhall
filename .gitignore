.idea
*.sqlite3

.venv/

__pycache__/
*.pyc

**/node_modules/**

yarn-error.log

# yarn is the package manager here and "yarn.lock" is the lock file. npm writes its own on any "npm
# install" - the smoke server falls back to npm when yarn is absent - and a second lock file that
# nobody reads goes stale silently.
package-lock.json

# The compiled Tailwind stylesheet. "yarn build:css" writes it from "assets/css/tailwind.css"; see
# docs/contributing/setup.md. The directory rather than the file, so a source map or a second sheet
# does not have to be remembered here later.
static/dist/

__pycache__/
*.py[cod]

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Scratch state for the /implement-story skill: specs, plans, CI logs and review shards.
.claude/runs/

# Git worktrees the agent skills check out inside the repo. Registered worktrees are still untracked
# content here, so without this a nested checkout of the project can be committed by accident.
.claude/worktrees/

# Snapshots and screenshots the Playwright MCP server drops here during a content review.
.playwright-mcp/
